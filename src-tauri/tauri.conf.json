{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YtbDownGUI",
  "version": "1.0.7",
  "identifier": "com.litotime.ytbdowngui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "YtbDownGUI",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ],
    "resources": [
      "Credits.rtf"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Xuefeng Huang (HCDD4TQBT8)"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQTY2MkVBRDIxMzk1M0MKUldROGxSUFM2bUttTzFrZnZVN0NkV0pxNFQ1MUdqNi9seEtjSkNwSUUyOUwyVlhiTFFnV0NiU3MK",
      "endpoints": [
        "https://upgrade.ytbdown.litotime.com/v1/app/pro/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
