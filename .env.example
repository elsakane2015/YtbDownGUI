# Client build-time Pro entitlement configuration.
#
# Tauri/Cargo does not automatically load this file. Export the values in
# your shell, CI job, or release script before running `pnpm tauri dev` or
# `pnpm tauri build`.

# Optional in development. Override this for local or staging license servers.
# If unset, the client uses the production endpoint from the development plan.
YTBDOWN_LICENSE_SERVER_URL=http://127.0.0.1:3000

# Required for production Tauri builds. Development builds may leave this empty,
# but Pro tokens cannot be verified or activated without the matching public key.
# Either paste a PEM with escaped newlines or export from a .pem file in shell.
YTBDOWN_LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
